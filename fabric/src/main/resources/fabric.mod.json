{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/anviaan/go-fish/",
    "issues": "https://github.com/anviaan/go-fish/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "",
        "modmenu.modrinth": ""
      }
    }
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.anvian.gofish.GoFishFabric"
    ],
    "client": [
      "net.anvian.gofish.GoFishFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric-api": "*",
    "minecraft": ">={minecraft_version}",
    "java": ">=17",
    "anvianslib": "{anvianslib_version}"
  }
}
